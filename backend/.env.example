# Required
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://<server-ip-or-domain>
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ownquesta?retryWrites=true&w=majority
SESSION_SECRET=<openssl rand -hex 32>

# Recommended
BACKEND_URL=http://<server-ip-or-domain>/backend

# Optional features
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://<server-ip-or-domain>/backend/api/auth/google/callback
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=OwnQuesta
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
