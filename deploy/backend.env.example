# Copy to backend/.env on the server and fill in the real values.
PORT=5000
NODE_ENV=production
# MongoDB Atlas free tier is recommended on a small instance (allow the EC2 IP in Atlas Network Access).
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/ownquesta
SESSION_SECRET=change-me-long-random
JWT_SECRET=change-me-long-random
# Replace 13.209.7.181 with your Elastic IP / domain.
FRONTEND_URL=http://13.209.7.181
ALLOWED_ORIGINS=http://13.209.7.181
BACKEND_URL=http://13.209.7.181/backend
GEN_AGENT_URL=http://127.0.0.1:8000
# Google OAuth: Google rejects bare IPs as redirect URIs, so this needs a domain.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://YOUR_DOMAIN/backend/api/auth/google/callback
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=Ownquesta
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
